// AgentVault — data model
// Организация владеет агентами, кошельками и политиками.
// Каждая трата агента -> Transaction, прошедшая через Policy Engine.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum AgentStatus {
  ACTIVE
  PAUSED
  REVOKED
}

enum TransactionStatus {
  APPROVED // прошла все политики
  PENDING  // ждёт человеческого одобрения
  BLOCKED  // нарушила политику
  REJECTED // человек отклонил
}

enum Plan {
  FREE
  STARTER
  GROWTH
  SCALE
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  INCOMPLETE
}

enum PaymentRequestStatus {
  OPEN
  PAID
  CANCELED
}

enum Role {
  OWNER
  ADMIN
  MEMBER
}

enum CardNetwork {
  VISA
  USDC_BASE // USDC-карта на Base L2
}

enum CardStatus {
  ACTIVE
  FROZEN
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  createdAt DateTime @default(now())

  users           User[]
  agents          Agent[]
  policies        Policy[]
  wallets         Wallet[]
  transactions    Transaction[]
  subscription    Subscription?
  cards           VirtualCard[]
  transfers       Transfer[]
  paymentRequests PaymentRequest[]
}

// Человек-пользователь дашборда (в отличие от Agent — это не бот).
model User {
  id           String   @id @default(cuid())
  orgId        String
  email        String   @unique
  name         String?
  passwordHash String
  role         Role     @default(OWNER)
  createdAt    DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Subscription {
  id    String @id @default(cuid())
  orgId String @unique

  plan   Plan               @default(FREE)
  status SubscriptionStatus @default(ACTIVE)

  // Связь со Stripe (null в FREE / dev-режиме без ключа).
  stripeCustomerId     String?
  stripeSubscriptionId String? @unique
  currentPeriodEnd     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
}

model Agent {
  id         String      @id @default(cuid())
  orgId      String
  name       String
  apiKeyHash String      @unique // sha256 от ключа; сам ключ не храним
  status     AgentStatus @default(ACTIVE)
  createdAt  DateTime    @default(now())

  org          Organization  @relation(fields: [orgId], references: [id], onDelete: Cascade)
  wallet       Wallet?
  transactions Transaction[]
  card         VirtualCard?

  sentTransfers     Transfer[]       @relation("TransferFrom")
  receivedTransfers Transfer[]       @relation("TransferTo")
  requestsAsPayee   PaymentRequest[] @relation("PRPayee")
  requestsAsPayer   PaymentRequest[] @relation("PRPayer")

  @@index([orgId])
}

// Перевод денег между агентами (agent-to-agent payment).
// Проходит через Policy Engine отправителя.
model Transfer {
  id          String            @id @default(cuid())
  orgId       String // организация отправителя (для дашборда)
  fromAgentId String
  toAgentId   String
  amount      Int // в центах
  currency    String            @default("USD")
  memo        String?
  category    String            @default("a2a")
  status      TransactionStatus
  reason      String?
  createdAt   DateTime          @default(now())
  decidedAt   DateTime?
  decidedBy   String?

  org       Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  fromAgent Agent        @relation("TransferFrom", fields: [fromAgentId], references: [id], onDelete: Cascade)
  toAgent   Agent        @relation("TransferTo", fields: [toAgentId], references: [id], onDelete: Cascade)

  paymentRequest PaymentRequest?

  @@index([orgId])
  @@index([fromAgentId])
  @@index([toAgentId])
}

// Счёт, который один агент выставляет другому. Оплата создаёт Transfer.
model PaymentRequest {
  id           String               @id @default(cuid())
  orgId        String // организация получателя счёта (payee)
  payeeAgentId String // кто выставил счёт и получит деньги
  payerAgentId String? // от кого ждут оплату (опционально)
  amount       Int // в центах
  currency     String               @default("USD")
  memo         String?
  category     String               @default("a2a")
  status       PaymentRequestStatus @default(OPEN)
  transferId   String?              @unique
  createdAt    DateTime             @default(now())

  org      Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  payee    Agent        @relation("PRPayee", fields: [payeeAgentId], references: [id], onDelete: Cascade)
  payer    Agent?       @relation("PRPayer", fields: [payerAgentId], references: [id], onDelete: SetNull)
  transfer Transfer?    @relation(fields: [transferId], references: [id], onDelete: SetNull)

  @@index([orgId])
}

model VirtualCard {
  id      String @id @default(cuid())
  orgId   String
  agentId String @unique

  network  CardNetwork @default(USDC_BASE)
  last4    String // последние 4 цифры (только для отображения)
  expMonth Int
  expYear  Int
  status   CardStatus  @default(ACTIVE)

  createdAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Wallet {
  id       String @id @default(cuid())
  orgId    String
  agentId  String @unique
  currency String @default("USD")

  // Баланс и дневной счётчик трат (в минимальных единицах — центах).
  balance      Int      @default(0)
  dailySpent   Int      @default(0)
  dailyResetAt DateTime @default(now())

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Policy {
  id    String @id @default(cuid())
  orgId String
  name  String

  // Лимиты в центах. null = без ограничения.
  maxPerTransaction  Int?
  dailyLimit         Int?
  requireApprovalOver Int?

  // Разрешённые категории трат. Пустой массив = разрешено всё.
  allowedCategories String[] @default([])

  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())

  org Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)

  @@index([orgId])
}

model Transaction {
  id       String            @id @default(cuid())
  orgId    String
  agentId  String
  amount   Int // в центах
  currency String            @default("USD")
  merchant String
  category String
  status   TransactionStatus
  reason   String? // почему BLOCKED / PENDING
  createdAt DateTime         @default(now())
  decidedAt DateTime? // когда человек одобрил/отклонил
  decidedBy String?

  org   Organization @relation(fields: [orgId], references: [id], onDelete: Cascade)
  agent Agent        @relation(fields: [agentId], references: [id], onDelete: Cascade)

  @@index([orgId])
  @@index([agentId])
  @@index([status])
}
