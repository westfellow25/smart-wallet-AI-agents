# --- API ---
PORT=4000
NODE_ENV=development

# --- Database (Postgres из docker-compose) ---
DATABASE_URL="postgresql://agentvault:agentvault@localhost:5432/agentvault?schema=public"

# --- Redis (из docker-compose) ---
REDIS_URL="redis://localhost:6379"

# --- Auth ---
JWT_SECRET="change-me-in-production"

# --- Notifications (опционально) ---
# Slack incoming webhook или любой POST-приёмник — туда падают
# уведомления о тратах/переводах, ждущих одобрения человека.
NOTIFY_WEBHOOK_URL=""

# --- Stripe (Фаза 4) ---
# Без ключа billing работает в dev-режиме: апгрейд тарифа применяется
# напрямую, без реальной оплаты.
STRIPE_SECRET_KEY=""
STRIPE_WEBHOOK_SECRET=""
# Stripe Price ID для каждого платного тарифа (price_...):
STRIPE_PRICE_STARTER=""
STRIPE_PRICE_GROWTH=""
STRIPE_PRICE_SCALE=""
# Куда возвращать после оплаты:
DASHBOARD_URL="http://localhost:3000"
